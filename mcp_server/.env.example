# Local dev only - Databricks Apps deployment gets these from app.yaml / secrets instead.

# Courtesy header NWS asks API callers to set (not a secret, just contact info).
NWS_USER_AGENT="weather-mcp-homework (contact: your-email@example.com)"

# Port the MCP server binds to locally (Databricks Apps injects DATABRICKS_APP_PORT in prod).
PORT=8000

# Where the JSONL query log is written (read by the optional dashboard app).
QUERY_LOG_PATH=./query_log.jsonl
